+// Quiver: PCから頼まれたマウス移動（まだ出していない残り）
+static int32_t quiver_move_x = 0;
+static int32_t quiver_move_y = 0;
+static int32_t quiver_move_step = 0;
+
+void quiver_move(int16_t dx, int16_t dy, uint16_t step, uint8_t flags) {
+    if (flags & 1) {
+        quiver_move_x = 0;
+        quiver_move_y = 0;
+    }
+    // 送り過ぎで溢れないよう、未処理の量に上限をかける
+    quiver_move_x = std::max<int32_t>(-100000, std::min<int32_t>(100000, quiver_move_x + dx));
+    quiver_move_y = std::max<int32_t>(-100000, std::min<int32_t>(100000, quiver_move_y + dy));
+    quiver_move_step = step;
+}
+
+static inline int32_t quiver_take(int32_t& remaining, int32_t step) {
+    int32_t lim = (step > 0) ? step : 2000;  // 1フレームで出せる上限（16bitの範囲に収める）
+    int32_t v = std::max<int32_t>(-lim, std::min<int32_t>(lim, remaining));
+    remaining -= v;
+    return v;
+}
